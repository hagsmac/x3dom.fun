<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Interchange" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
<head><meta name="title" content="Bouncing Ball"/></head>
<Scene>
<Viewpoint position="0 3 12" description="Front"/>
<Background skyColor="0.6 0.8 1"/>
<Transform translation="0 -0.1 0"><Shape><Appearance><Material diffuseColor="0.3 0.6 0.3"/></Appearance><Box size="12 0.2 4"/></Shape></Transform>
<Transform DEF="Ball_X" translation="-4 0.5 0"><Transform DEF="Squash_X"><Shape><Appearance><Material diffuseColor="1 0.2 0.2" specularColor="1 1 1"/></Appearance><Sphere radius="0.5"/></Shape></Transform></Transform>
<TimeSensor DEF="Clock" cycleInterval="3" loop="true"/>
<PositionInterpolator DEF="Path" key="0.000 0.050 0.100 0.150 0.200 0.250 0.300 0.350 0.400 0.450 0.500 0.550 0.600 0.650 0.700 0.750 0.800 0.850 0.900 0.950 1.000" keyValue="-4.000 0.500 0 -3.600 1.940 0 -3.200 3.060 0 -2.800 3.860 0 -2.400 4.340 0 -2.000 4.500 0 -1.600 4.340 0 -1.200 3.860 0 -0.800 3.060 0 -0.400 1.940 0 0.000 0.500 0 0.400 1.940 0 0.800 3.060 0 1.200 3.860 0 1.600 4.340 0 2.000 4.500 0 2.400 4.340 0 2.800 3.860 0 3.200 3.060 0 3.600 1.940 0 4.000 0.500 0"/>
<PositionInterpolator DEF="Squash" key="0.000 0.050 0.100 0.150 0.200 0.250 0.300 0.350 0.400 0.450 0.500 0.550 0.600 0.650 0.700 0.750 0.800 0.850 0.900 0.950 1.000" keyValue="1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000 1.000"/>
<ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Path" toField="set_fraction"/>
<ROUTE fromNode="Path" fromField="value_changed" toNode="Ball_X" toField="set_translation"/>
<ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Squash" toField="set_fraction"/>
<ROUTE fromNode="Squash" fromField="value_changed" toNode="Squash_X" toField="set_scale"/>
</Scene>
</X3D>
